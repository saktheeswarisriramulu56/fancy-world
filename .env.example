# Fancy World - Environment Variables
# Copy this file to .env and fill in your actual values

# Flask Configuration
SECRET_KEY=your_secret_key_change_this_in_production
DEBUG=True

# MongoDB Atlas Configuration
# Get your connection string from MongoDB Atlas dashboard
# Format: mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
DATABASE_NAME=fancyworld

# For local MongoDB (development)
# MONGODB_URI=mongodb://localhost:27017/
# DATABASE_NAME=fancyworld

# CNN Model Path (optional)
CNN_MODEL_PATH=ai_models/jewellery_cnn.h5

# Payment Gateway Configuration (optional - for future integration)
PAYMENT_GATEWAY=simulated
# RAZORPAY_KEY_ID=your_razorpay_key_id
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email Configuration (optional - for notifications)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your_email@gmail.com
# MAIL_PASSWORD=your_app_password
